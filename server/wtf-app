#!/usr/bin/env bash
# wtf-app: runs the apps behind *.emmett.wtf on Omarchy. Each app is a git checkout in /home/emmett/services/<name>,
# a Caddy site, and either a Docker Compose project or a folder of static files. Run it with sudo.
#
#   wtf-app add <name> <owner/repo> [--host <host>]... [--static <dir>]   register an app and deploy it
#   wtf-app hosts <name> --host <host>... [--redirect <host>]...           change an app's hostnames
#   wtf-app deploy <name> [--force]     deploy if origin/main has moved, or always with --force
#   wtf-app deploy-all                  what wtf-deploy.timer runs every minute
#   wtf-app sync                        add every site listed in emmett-wtf's sites/*.json that isn't registered yet
#   wtf-app edits                       commit the gallery's queued card edits (hide, publish, delete) and deploy them
#   wtf-app list                        every app, its hosts, port and deployed commit
#   wtf-app logs <name>                 the container's recent logs
#   wtf-app remove <name>               stop the app and delete its checkout, site and registration
#
# <name> serves <name>.emmett.wtf unless --host says otherwise. A --redirect host sends visitors to the first --host. See server/README.md for what an app repo must contain.
set -euo pipefail

ROOT=${WTF_ROOT:-}  # empty on the server; tests point it at a sandbox
APPS=$ROOT/etc/wtf/apps
SECRETS=$ROOT/etc/wtf/secrets
STATE=$ROOT/var/lib/wtf
SERVICES=$ROOT/home/emmett/services
CADDY_SITES=$ROOT/etc/caddy/sites
OWNERS=${WTF_OWNERS:-emm3ttarmstrong armstrong-agency-internal armstrong-agency-shared}
HUB_APP=emmett-wtf
EDITS=$STATE/hub-edits                         # the hub's container writes queued card edits here
DEPLOY_KEY=$ROOT/home/emmett/.ssh/emmett-wtf-deploy  # write access to the hub repo only
FIRST_PORT=4100
GIT=(sudo -u emmett env GIT_TERMINAL_PROMPT=0 git)

die() { echo "wtf-app: $*" >&2; exit 1; }
[[ $(id -u) -eq 0 ]] || die "run this with sudo"
valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || die "'$1' isn't a valid name (lowercase letters, digits, dashes)"; }
load() {
  valid_name "$1"
  [[ -f $APPS/$1.env ]] || die "no app named '$1'"
  NAME= REPO= HOSTS= REDIRECTS= PORT= MODE= STATIC_DIR=
  # shellcheck disable=SC1090
  . "$APPS/$1.env"
}
compose() { (cd "$SERVICES/$NAME" && PORT=$PORT docker compose -p "wtf-$NAME" "$@"); }

save_app() {
  printf 'NAME=%q\nREPO=%q\nHOSTS=%q\nREDIRECTS=%q\nPORT=%s\nMODE=%s\nSTATIC_DIR=%q\n' \
    "$NAME" "$REPO" "$HOSTS" "$REDIRECTS" "$PORT" "$MODE" "$STATIC_DIR" > "$APPS/$NAME.env"
}

next_port() {
  local port=$FIRST_PORT
  while grep -qsx "PORT=$port" "$APPS"/*.env || ss -ltn | grep -q ":$port "; do port=$((port + 1)); done
  echo "$port"
}

write_site() {
  local file=$CADDY_SITES/$NAME.caddy addresses=
  for host in $HOSTS; do addresses+="${addresses:+, }$host:80"; done
  if [[ $MODE == static ]]; then
    printf '%s {\n\troot * %s\n\tfile_server\n}\n' "$addresses" "$SERVICES/$NAME/$STATIC_DIR" > "$file"
  else
    printf '%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$addresses" "$PORT" > "$file"
  fi
  for host in $REDIRECTS; do
    printf '%s:80 {\n\tredir https://%s{uri} permanent\n}\n' "$host" "${HOSTS%% *}" >> "$file"
  done
  if ! caddy validate --config "$ROOT/etc/caddy/Caddyfile" > /dev/null 2>&1; then
    rm -f "$file"
    die "Caddy rejected the site for $NAME, so it was not added"
  fi
  # The Caddyfile has `admin off`, so Caddy cannot reload in place.
  systemctl restart caddy
}

cmd_add() {
  local name=${1:-} repo=${2:-} hosts= static=
  [[ -n $name && -n $repo ]] || die "usage: wtf-app add <name> <owner/repo> [--host <host>]... [--static <dir>]"
  shift 2
  while (($#)); do
    case $1 in
      --host) hosts+="${hosts:+ }$2"; shift 2 ;;
      --static) static=$2; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  valid_name "$name"
  [[ $repo =~ ^([A-Za-z0-9-]+)/([A-Za-z0-9._-]+)$ ]] || die "'$repo' isn't owner/repo"
  [[ " $OWNERS " == *" ${BASH_REMATCH[1]} "* ]] || die "repos must belong to one of: $OWNERS"
  [[ ! -e $APPS/$name.env ]] || die "'$name' is already registered"
  [[ -z $static || ! $static =~ (^/|\.\.) ]] || die "--static takes a folder inside the repo"
  hosts=${hosts:-$name.emmett.wtf}
  for host in $hosts; do
    [[ $host =~ ^[a-z0-9.-]+$ ]] || die "'$host' isn't a hostname"
    ! grep -qs -E "^(HOSTS|REDIRECTS)=.*\b$host\b" "$APPS"/*.env || die "$host already belongs to another app"
  done

  install -d -m 755 "$APPS" "$STATE" "$CADDY_SITES"
  install -d -m 700 "$SECRETS"
  install -d -o emmett -g emmett "$SERVICES"
  [[ -d $SERVICES/$name ]] || "${GIT[@]}" clone --quiet "https://github.com/$repo.git" "$SERVICES/$name"
  NAME=$name REPO=$repo HOSTS=$hosts REDIRECTS= PORT=$(next_port) MODE=${static:+static} STATIC_DIR=$static
  MODE=${MODE:-docker}
  save_app
  write_site
  echo "added $name: $hosts"
  cmd_deploy "$name" --force
}

cmd_hosts() {
  load "${1:-}"
  shift
  local hosts= redirects=
  while (($#)); do
    case $1 in
      --host) hosts+="${hosts:+ }$2"; shift 2 ;;
      --redirect) redirects+="${redirects:+ }$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n $hosts ]] || die "usage: wtf-app hosts <name> --host <host>... [--redirect <host>]..."
  for host in $hosts $redirects; do
    [[ $host =~ ^[a-z0-9.-]+$ ]] || die "'$host' isn't a hostname"
    ! grep -s -E "^(HOSTS|REDIRECTS)=.*\b$host\b" "$APPS"/*.env | grep -qv "^$APPS/$NAME.env:" || die "$host already belongs to another app"
  done
  HOSTS=$hosts REDIRECTS=$redirects
  save_app
  write_site
  echo "$NAME: serves $HOSTS${REDIRECTS:+, redirects $REDIRECTS}"
}

# Deploys origin/main. A commit that failed to deploy isn't tried again until main moves, so a broken build doesn't loop.
cmd_deploy() {
  load "${1:-}"
  local force=${2:-} dir=$SERVICES/$NAME sha
  "${GIT[@]}" -C "$dir" fetch --quiet origin main
  sha=$("${GIT[@]}" -C "$dir" rev-parse origin/main)
  if [[ $force != --force ]]; then
    [[ $(cat "$STATE/$NAME.sha" 2> /dev/null) != "$sha" ]] || return 0
    [[ $(cat "$STATE/$NAME.failed" 2> /dev/null) != "$sha" ]] || return 0
  fi
  echo "deploying $NAME ${sha:0:7}"
  "${GIT[@]}" -C "$dir" checkout --quiet --force -B main "$sha"
  if deploy_checkout; then
    echo "$sha" > "$STATE/$NAME.sha"
    rm -f "$STATE/$NAME.failed"
    echo "deployed $NAME ${sha:0:7}"
    [[ $NAME != "$HUB_APP" ]] || cmd_sync
  else
    echo "$sha" > "$STATE/$NAME.failed"
    die "$NAME ${sha:0:7} failed to deploy; whatever was running before is still running"
  fi
}

deploy_checkout() {
  [[ $MODE == static ]] && return 0
  local dir=$SERVICES/$NAME
  if [[ -f $SECRETS/$NAME.env ]]; then
    install -m 600 -o emmett -g emmett "$SECRETS/$NAME.env" "$dir/.env"
  fi
  compose up -d --build --remove-orphans || return 1
  for _ in $(seq 45); do
    local code
    code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:$PORT/" || true)
    [[ $code =~ ^[1-4] ]] && return 0
    sleep 2
  done
  echo "$NAME didn't answer on port $PORT within 90 seconds" >&2
  compose logs --tail 30 >&2 || true
  return 1
}

cmd_deploy_all() {
  local failed=0
  for file in "$APPS"/*.env; do
    [[ -e $file ]] || continue
    (cmd_deploy "$(basename "$file" .env)") || failed=1
  done
  return $failed
}

# The hub repo's sites/<name>.json files are the list of subdomain apps. Sync only ever adds: removing is `wtf-app remove`.
cmd_sync() {
  local file name line
  for file in "$SERVICES/$HUB_APP"/sites/*.json; do
    [[ -e $file ]] || continue
    name=$(basename "$file" .json)
    [[ ! -e $APPS/$name.env ]] || continue
    line=$(python3 - "$file" "$name" <<'PY'
import json, shlex, sys
site = json.load(open(sys.argv[1]))
name = sys.argv[2]
host = site.get("host", f"{name}.emmett.wtf")
if host != "emmett.wtf" and not host.endswith(".emmett.wtf"):
    sys.exit(f"{host} is not under emmett.wtf")
args = [name, site["repo"], "--host", host]
if site.get("static"):
    args += ["--static", site["static"]]
print(" ".join(shlex.quote(a) for a in args))
PY
    ) || { echo "wtf-app: skipped sites/$name.json" >&2; continue; }
    # A site that fails its first deploy stays registered and is retried when its repo's main moves.
    (eval "cmd_add $line") || echo "wtf-app: $name was added but did not deploy" >&2
  done
}

# The gallery's card controls queue one JSON file per edit. Each run applies them all to a fresh checkout of main as one
# commit, pushes it with the hub's deploy key, and deploys. A request that can't be applied or pushed moves to failed/.
cmd_edits() {
  local dir=$SERVICES/$HUB_APP files=("$EDITS"/*.json) message
  [[ -e ${files[0]} ]] || return 0
  load "$HUB_APP"
  install -d -m 755 "$EDITS/failed"
  "${GIT[@]}" -C "$dir" fetch --quiet origin main
  "${GIT[@]}" -C "$dir" checkout --quiet --force -B main origin/main
  if message=$(sudo -u emmett python3 - "$dir" "${files[@]}" <<'PY'
import json, re, shutil, sys
from pathlib import Path

repo, requests = Path(sys.argv[1]), sys.argv[2:]
done = []
for request in requests:
    try:
        edit = json.loads(Path(request).read_text())
        slug, action = edit["slug"], edit["action"]
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug) or action not in ("hide", "unhide", "publish", "unpublish", "delete"):
            raise ValueError("bad request")
        folder = repo / "prototypes" / slug
        meta = folder / "metadata.json"
        if not meta.is_file():
            continue  # already deleted
        if action == "delete":
            shutil.rmtree(folder)
            for media in [*repo.glob(f"public/thumbnails/{slug}-*.png"), *repo.glob(f"public/og/{slug}.*")]:
                media.unlink()
        else:
            data = json.loads(meta.read_text())
            if action in ("hide", "unhide"):
                data["hidden"] = action == "hide"
            else:
                data["public"] = action == "publish"
            meta.write_text(json.dumps(data, indent=2) + "\n")
        done.append(f"{action} {slug}")
    except Exception as error:
        print(f"skipped {request}: {error}", file=sys.stderr)
print("Gallery: " + ", ".join(done) if done else "")
PY
  ) && { [[ -z $message ]] || push_edits "$dir" "$message"; }; then
    rm -f "${files[@]}"
    [[ -z $message ]] || { echo "$message"; cmd_deploy "$HUB_APP"; }
  else
    mv "${files[@]}" "$EDITS/failed/"
    "${GIT[@]}" -C "$dir" reset --quiet --hard origin/main
    die "the queued gallery edits could not be committed; they are in $EDITS/failed"
  fi
}

push_edits() {
  "${GIT[@]}" -C "$1" add -A
  "${GIT[@]}" -C "$1" diff --cached --quiet && return 0
  "${GIT[@]}" -C "$1" -c user.name="emmett.wtf gallery" -c user.email="gallery@emmett.wtf" commit --quiet -m "$2"
  sudo -u emmett env GIT_SSH_COMMAND="ssh -i $DEPLOY_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
    git -C "$1" push --quiet "git@github.com:$REPO.git" HEAD:main
}

cmd_list() {
  for file in "$APPS"/*.env; do
    [[ -e $file ]] || continue
    load "$(basename "$file" .env)"
    local sha
    sha=$(cat "$STATE/$NAME.sha" 2> /dev/null || echo "not deployed")
    printf '%-20s %-8s %-6s %-9s %s\n' "$NAME" "$MODE" "$PORT" "${sha:0:7}" "$HOSTS${REDIRECTS:+ (redirects: $REDIRECTS)}"
  done
}

cmd_logs() { load "${1:-}"; [[ $MODE == docker ]] || die "$NAME is static and has no logs"; compose logs --tail "${2:-100}"; }

cmd_remove() {
  load "${1:-}"
  [[ $NAME != "$HUB_APP" ]] || die "refusing to remove the hub itself"
  [[ $MODE != docker ]] || compose down --remove-orphans || true
  rm -f "$CADDY_SITES/$NAME.caddy" "$APPS/$NAME.env" "$SECRETS/$NAME.env" "$STATE/$NAME.sha" "$STATE/$NAME.failed"
  rm -rf "${SERVICES:?}/$NAME"
  # The Caddyfile has `admin off`, so Caddy cannot reload in place.
  systemctl restart caddy
  echo "removed $NAME"
}

command=${1:-}
shift || true
case $command in
  list) cmd_list ;;
  logs) cmd_logs "$@" ;;
  add | hosts | deploy | deploy-all | sync | edits | remove)
    exec 9> /run/wtf-app.lock
    flock -w 900 9 || die "another wtf-app run held the lock for 15 minutes"
    "cmd_${command//-/_}" "$@"
    ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
